# 复制为 .env 后填写。只用测试专用钱包！永远不要把 .env 提交到 Git。
# 同一个私钥可以同时用于源链 / Lasna / 目标链（地址相同，各链分别要有余额）。
PRIVATE_KEY=0x...

# 源链 & 目标链（默认都用 Ethereum Sepolia，最简单；也可换成 Base Sepolia / Unichain Sepolia）
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ORIGIN_CHAIN_ID=11155111
DEST_CHAIN_ID=11155111
# 目标链的 Callback Proxy（见 docs/cheatsheet.md）：Sepolia / Base Sepolia / Unichain Sepolia 三选一
CALLBACK_PROXY=0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4

# Reactive 侧
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/

# 以下三项由部署脚本依次产出，按顺序填回
ORIGIN_ADDR=
REACTIVE_ADDR=
CALLBACK_ADDR=
